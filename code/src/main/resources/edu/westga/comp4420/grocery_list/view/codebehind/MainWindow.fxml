<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="guiPane" minHeight="99.0" minWidth="160.0" prefHeight="380.0" prefWidth="380.0"
   xmlns="http://javafx.com/javafx/23" xmlns:fx="http://javafx.com/fxml/1"
   fx:controller="edu.westga.comp4420.grocery_list.view.codebehind.MainWindow">
   <children>
      <Label layoutX="28.0" layoutY="14.0" text="Law School Applications">
         <font>
            <Font name="System Bold" size="22.0" />
         </font>
      </Label>

      <TextField fx:id="searchField" layoutX="14.0" layoutY="55.0" onKeyReleased="#searchSchools"
         prefHeight="26.0" prefWidth="312.0" promptText="Search by school, location, or status" />

      <ListView fx:id="lawSchools" layoutX="14.0" layoutY="90.0"
         onMouseClicked="#openSelectedSchool" prefHeight="278.0" prefWidth="312.0" />

      <Button layoutX="337.0" layoutY="90.0" mnemonicParsing="false" onAction="#addSchool" text="+">
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
      </Button>
   </children>
</AnchorPane>