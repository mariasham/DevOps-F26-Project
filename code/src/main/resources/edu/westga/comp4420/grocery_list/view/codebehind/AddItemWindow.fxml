<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="guiPane" minHeight="99.0" minWidth="160.0" prefHeight="360.0" prefWidth="430.0"
    xmlns="http://javafx.com/javafx/23" xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="edu.westga.comp4420.grocery_list.view.codebehind.AddItemWindow">
    <children>
        <Label layoutX="20.0" layoutY="20.0" text="Add Law School">
            <font>
                <Font name="System Bold" size="22.0" />
            </font>
        </Label>

        <Label layoutX="20.0" layoutY="70.0" text="Name" />
        <TextField fx:id="nameField" layoutX="130.0" layoutY="66.0" prefWidth="260.0" />

        <Label layoutX="20.0" layoutY="110.0" text="Location" />
        <TextField fx:id="locationField" layoutX="130.0" layoutY="106.0" prefWidth="260.0" />

        <Label layoutX="20.0" layoutY="150.0" text="Deadline" />
        <TextField fx:id="deadlineField" layoutX="130.0" layoutY="146.0" prefWidth="260.0" />

        <Label layoutX="20.0" layoutY="190.0" text="Status" />
        <TextField fx:id="statusField" layoutX="130.0" layoutY="186.0" prefWidth="260.0" />

        <Label layoutX="20.0" layoutY="230.0" text="Application Link" />
        <TextField fx:id="linkField" layoutX="130.0" layoutY="226.0" prefWidth="260.0" />

        <Button layoutX="130.0" layoutY="285.0" mnemonicParsing="false" onAction="#addLawSchool"
            text="Add" />
        <Button layoutX="200.0" layoutY="285.0" mnemonicParsing="false" onAction="#cancel"
            text="Cancel" />
    </children>
</AnchorPane>